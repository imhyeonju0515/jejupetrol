# 복사해서 .env 로 사용하세요: cp .env.example .env  (.env 는 절대 커밋하지 마세요)

# ---- 동작 모드 ----
# true 이면 API 키 없이 샘플 주유소/가짜 가격/콘솔 알림으로 전체 흐름을 확인할 수 있습니다.
MOCK=true

# ---- 외부 API 키 (MOCK=false 일 때 필요) ----
# 오피넷(한국석유공사) https://www.opinet.co.kr/user/custapi/openApiInfo.do
OPINET_API_KEY=
# 카카오 Developers > 내 애플리케이션 > REST API 키 (카카오모빌리티 길찾기)
KAKAO_REST_API_KEY=
HTTP_TIMEOUT_SECONDS=5

# ---- 서버 ----
DATABASE_URL=sqlite:///./jeju_gas.db
# 쉼표로 구분 (프론트 개발 서버 주소)
CORS_ORIGINS=http://localhost:5173
# 빌드된 프론트엔드 경로. 존재하면 백엔드가 / 에서 함께 서빙합니다.
FRONTEND_DIST=../frontend/dist

# ---- 캐시 ----
PRICE_CACHE_TTL_SECONDS=420
TRAVEL_CACHE_TTL_SECONDS=600

# ---- 스케줄러 / 알림 ----
SCHEDULER_ENABLED=true
# 알림 검사 주기(분). 15~30 권장
ALERT_CHECK_INTERVAL_MINUTES=20
# 한 사이클에 처리할 (위치,유종) 그룹 수 상한 - 넘으면 다음 사이클에 이어서 처리
ALERT_BATCH_SIZE=50
ALERT_BATCH_DELAY_SECONDS=0.3
NOTIFY_MAX_ATTEMPTS=3

# ---- 웹 푸시 (VAPID) : README 의 "VAPID 키 생성" 참고 ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- 이메일 알림 (선택) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
